---
import '../styles/global.css';
import { site, base, withBase, gate, links } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.title;
const current = Astro.url.pathname;

const nav = [
  { href: withBase('projects/'), label: 'Проекты' },
  { href: withBase('students/'), label: 'Студентам' },
  { href: withBase('me/'), label: 'Обо мне' },
];

// Раздел «Т1 + МАИ» — внутри него оформление в духе Т1 (см. стили .t1).
const isT1 = current.startsWith(withBase('students/mai/'));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body class={isT1 ? 'theme-t1' : undefined}>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={base}>
          <span class="mark">О</span>
          <span>Олег Орловский</span>
        </a>
        {isT1 && (
          <div class="t1-badge">
            <span class="t1-badge-mark">Т1</span>
            <span>+ МАИ</span>
          </div>
        )}
        <nav class="site-nav">
          {nav.map((item) => (
            <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <div id="gate" class="gate" hidden>
          <h1>Материалы курса</h1>
          <p class="lead">
            Это раздел для студентов курса. Введите код, который я дал на занятии, — откроются
            материалы.
          </p>
          <form id="gate-form">
            <input
              id="gate-code"
              type="password"
              name="code"
              placeholder="Код доступа"
              autocomplete="off"
              aria-label="Код доступа"
            />
            <button type="submit">Открыть</button>
          </form>
          <p id="gate-error" class="muted" hidden>Код не подошёл. Проверьте раскладку и попробуйте ещё раз.</p>
        </div>

        <div id="page-content">
          <slot />
        </div>
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Олег Орловский</span>
        <span>
          <a href={links.github}>GitHub</a> ·
          <a href={links.telegram}>Телеграм</a>
        </span>
      </div>
    </footer>

    <script is:inline define:vars={{ gate, base }}>
      (function () {
        const cfg = { scope: gate.scope, hash: gate.hash, key: gate.key, base: base };
        const path = location.pathname;
        const rel = path.startsWith(cfg.base) ? path.slice(cfg.base.length) : path;
        const isProtected = cfg.scope.some((s) => rel === s || rel.startsWith(s) || rel.startsWith(s + '/'));
        if (!isProtected) return;
        if (localStorage.getItem(cfg.key) === 'ok') return;

        function fnv1a(str) {
          let h = 0x811c9dc5;
          const bytes = new TextEncoder().encode(str);
          for (const b of bytes) {
            h ^= b;
            h = Math.imul(h, 0x01000193) >>> 0;
          }
          return h.toString(16).padStart(8, '0');
        }

        const content = document.getElementById('page-content');
        const box = document.getElementById('gate');
        const form = document.getElementById('gate-form');
        const input = document.getElementById('gate-code');
        const error = document.getElementById('gate-error');
        if (!content || !box || !form || !input || !error) return;

        content.hidden = true;
        box.hidden = false;
        input.focus();

        form.addEventListener('submit', (event) => {
          event.preventDefault();
          if (fnv1a(input.value.trim().toLowerCase()) === cfg.hash) {
            localStorage.setItem(cfg.key, 'ok');
            location.reload();
            return;
          }
          error.hidden = false;
          input.select();
        });
      })();
    </script>
    <script is:inline>
      // Увеличиваем картинки по клику: оверлей на весь экран, закрытие — клик или Esc
      (function () {
        const images = document.querySelectorAll('article img');
        if (!images.length) return;

        function close(box) {
          box.remove();
          document.body.style.overflow = '';
        }

        function open(src, alt) {
          const box = document.createElement('div');
          box.className = 'lightbox';
          const big = document.createElement('img');
          big.src = src;
          big.alt = alt || '';
          box.appendChild(big);
          box.addEventListener('click', () => close(box));
          document.addEventListener('keydown', function onKey(event) {
            if (event.key === 'Escape') {
              close(box);
              document.removeEventListener('keydown', onKey);
            }
          });
          document.body.style.overflow = 'hidden';
          document.body.appendChild(box);
        }

        images.forEach((img) => {
          img.setAttribute('tabindex', '0');
          img.setAttribute('role', 'button');
          img.setAttribute('title', 'Нажмите, чтобы увеличить');
          img.addEventListener('click', () => open(img.currentSrc || img.src, img.alt));
          img.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              open(img.currentSrc || img.src, img.alt);
            }
          });
        });
      })();
    </script>
  </body>
</html>
