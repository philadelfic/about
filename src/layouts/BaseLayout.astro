---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { base, withBase, gate, links } from '../data/site';
import { dict, type Lang } from '../data/i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** Абсолютный URL картинки для соцсетей (og:image); нет — тега не будет. */
  image?: string;
}

const current = Astro.url.pathname;
// Путь без базового префикса и без ведущего слэша: '' | 'projects/' | 'en/projects/'
const root = base.replace(/\/$/, '');
const rel = (current.startsWith(root) ? current.slice(root.length) : current).replace(/^\//, '');

// Язык страницы: русский в корне, английский — под /en/.
const lang: Lang = Astro.props.lang ?? (rel === 'en' || rel.startsWith('en/') ? 'en' : 'ru');
const t = dict[lang];

// Внутри «Т1 + МАИ» — только русский: без переключателей языка и темы.
const isT1 = current.startsWith(withBase('students/mai/'));
const showTools = !isT1;

const pageTitle = Astro.props.title ? `${Astro.props.title} — ${t.siteName}` : t.title;
const description = Astro.props.description ?? t.description;
const ogImage = Astro.props.image ?? undefined;

const nav = [
  { href: withBase(lang === 'en' ? 'en/projects/' : 'projects/'), label: t.nav.projects },
  { href: withBase(lang === 'en' ? 'en/students/' : 'students/'), label: t.nav.students },
  { href: withBase(lang === 'en' ? 'en/me/' : 'me/'), label: t.nav.me },
];

// Та же страница на другом языке.
const altHref =
  lang === 'en' ? withBase(rel.replace(/^en\/?/, '')) : withBase(`en/${rel}`);

const courseNav = [
  { href: withBase('students/mai/rl/topics/'), label: 'Темы' },
  { href: withBase('students/mai/rl/homework/'), label: 'Домашние задания' },
  { href: withBase('students/mai/rl/seminars/'), label: 'Семинары' },
];

const footerTagline = {
  ru: 'ИТ-лид команды разработки и преподаватель. Кадровые сервисы самообслуживания, курс по обучению с подкреплением, инструменты для работы с LLM-харнесами.',
  en: 'IT lead of a development team and a teacher. HR self-service systems, a reinforcement learning course, tools for LLM harnesses.',
}[lang];

const footerCols = {
  ru: { sections: 'Разделы', contact: 'Связь', githubPages: 'Опубликовано на GitHub Pages' },
  en: { sections: 'Sections', contact: 'Contact', githubPages: 'Published on GitHub Pages' },
}[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="alternate" hreflang="ru" href={new URL(lang === 'en' ? altHref : current, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(lang === 'en' ? current : altHref, Astro.site)} />

    {!isT1 && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
      </>
    )}

    <script is:inline define:vars={{ base }}>
      // Тема и язык до первой отрисовки: без мигания и прыжков.
      (function () {
        try {
          var theme = localStorage.getItem('about.theme');
          if (theme === 'dark' || theme === 'light') {
            document.documentElement.dataset.theme = theme;
          }
        } catch (e) {}

        try {
          var root = base.replace(/\/$/, '');
          var path = location.pathname;
          var rel = (path.indexOf(root) === 0 ? path.slice(root.length) : path).replace(/^\//, '');

          // Раздел курса «Т1 + МАИ» — только по-русски.
          if (rel.indexOf('students/mai') === 0) return;

          var isEn = rel === 'en' || rel.indexOf('en/') === 0;
          var saved = localStorage.getItem('about.lang');
          var browserRu = (navigator.language || 'ru').toLowerCase().indexOf('ru') === 0;
          var want = saved || (browserRu ? 'ru' : 'en');

          if (want === 'en' && !isEn) location.replace(root + '/en/' + rel);
          if (want === 'ru' && isEn) location.replace(root + '/' + rel.replace(/^en\/?/, ''));
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={isT1 ? 'theme-t1' : undefined}>
    {!isT1 && <canvas class="bg-graph" aria-hidden="true" />}

    {isT1 ? (
      <header class="t1-header">
        <div class="wrap">
          <a class="t1-logo" href={withBase('students/mai/')}>
            <img class="t1-logo-t1" src={withBase('img/brand/t1.svg')} alt="Т1" />
            <span class="t1-logo-plus">+</span>
            <img class="t1-logo-mai" src={withBase('img/brand/mai.svg')} alt="МАИ" />
          </a>
          <nav class="t1-nav">
            {courseNav.map((item) => (
              <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
          <a class="t1-chat" href={links.chat} target="_blank" rel="noopener">
            Чат группы →
          </a>
        </div>
        <span class="read-progress" aria-hidden="true" hidden>
          <span class="read-progress-fill"></span>
        </span>
      </header>
    ) : (
      <header class="site-header">
        <div class="wrap">
          <a class="brand" href={lang === 'en' ? withBase('en/') : base}>
            {t.siteName}
          </a>
          <nav class="site-nav">
            {nav.map((item) => (
              <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
          {showTools && (
            <div class="header-tools">
              <div class="lang-switch" aria-label={t.langLabel}>
                <a
                  href={lang === 'en' ? altHref : current}
                  data-lang="ru"
                  aria-current={lang === 'ru' ? 'true' : undefined}
                  title="Русский"
                >
                  ru
                </a>
                <a
                  href={lang === 'ru' ? altHref : current}
                  data-lang="en"
                  aria-current={lang === 'en' ? 'true' : undefined}
                  title="English"
                >
                  en
                </a>
              </div>
              <button class="tool-btn" type="button" data-theme-toggle>
                {t.theme.toDark}
              </button>
            </div>
          )}
        </div>
        <span class="read-progress" aria-hidden="true" hidden>
          <span class="read-progress-fill"></span>
        </span>
      </header>
    )}

    <main>
      <div class="wrap">
        <div id="gate" class="gate" hidden>
          <h2 class="gate-title">Материалы курса</h2>
          <p class="lead">
            Это раздел для студентов курса. Введите код, который я дал на занятии, — откроются
            материалы.
          </p>
          <form id="gate-form">
            <input
              id="gate-code"
              type="password"
              name="code"
              placeholder="Код доступа"
              autocomplete="off"
              aria-label="Код доступа"
            />
            <button type="submit">Открыть</button>
          </form>
          <p id="gate-error" class="muted" hidden>Код не подошёл. Проверьте раскладку и попробуйте ещё раз.</p>
        </div>

        <div id="page-content">
          <slot />
        </div>
      </div>
    </main>

    {isT1 ? (
      <footer class="t1-footer">
        <div class="wrap">
          <span>Т1 + МАИ · курс «Обучение с подкреплением»</span>
          <span>
            <a href={base}>На портал</a>
          </span>
        </div>
      </footer>
    ) : (
      <footer class="site-footer">
        <div class="wrap">
          <div class="footer-grid">
            <div>
              <p class="footer-name">{t.siteName}</p>
              <p class="footer-desc">{footerTagline}</p>
            </div>
            <div class="footer-col">
              <h2>{footerCols.sections}</h2>
              <ul>
                {nav.map((item) => (
                  <li><a href={item.href}>{item.label}</a></li>
                ))}
              </ul>
            </div>
            <div class="footer-col">
              <h2>{footerCols.contact}</h2>
              <ul>
                <li><a href={links.github}>GitHub</a></li>
                <li><a href={links.telegram}>Telegram</a></li>
              </ul>
            </div>
          </div>
          <div class="footer-bottom">
            <span>© {new Date().getFullYear()} {t.siteName}</span>
            <span>{footerCols.githubPages}</span>
          </div>
        </div>
      </footer>
    )}

    <button class="to-top" type="button" aria-label="Наверх">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7"></path>
      </svg>
    </button>

    <script is:inline>
      // «Где я на длинной странице»: полоса прогресса чтения и кнопка «наверх».
      // Без JS ничего не появляется: полоса скрыта атрибутом hidden, кнопка — opacity/visibility.
      (function () {
        try {
          var doc = document.documentElement;
          var bar = document.querySelector('.read-progress');
          var fill = bar ? bar.querySelector('.read-progress-fill') : null;
          var up = document.querySelector('.to-top');
          var ticking = false;

          // Прокручиваемая часть страницы: сколько осталось до низа.
          function room() {
            var left = doc.scrollHeight - window.innerHeight;
            return left > 0 ? left : 0;
          }

          function render() {
            ticking = false;
            var left = room();
            if (fill) {
              var done = left > 0 ? (window.scrollY / left) * 100 : 0;
              fill.style.width = (done > 100 ? 100 : done < 0 ? 0 : done) + '%';
            }
            if (up) up.classList.toggle('is-visible', window.scrollY > window.innerHeight);
          }

          function schedule() {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(render);
          }

          // Полоса нужна только на длинной странице (больше ~1,5 экрана).
          function measure() {
            if (bar) bar.hidden = room() < window.innerHeight * 0.5;
            render();
          }

          // Замер отложен в кадр: на resize важна не каждая промежуточная геометрия.
          function scheduleMeasure() {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(measure);
          }

          if (up) {
            up.addEventListener('click', function () {
              // Предпочтение «меньше движения» читаем в момент клика: пользователь мог
              // сменить настройку уже после загрузки страницы.
              var reduced = false;
              try {
                reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              } catch (e) {}
              window.scrollTo({ top: 0, behavior: reduced ? 'instant' : 'smooth' });
            });
          }

          window.addEventListener('scroll', schedule, { passive: true });
          // resize идёт через тот же rAF: при перетаскивании окна scrollHeight не читается
          // синхронно на каждое событие. Первый замер — сразу, чтобы полоса появилась без кадра.
          window.addEventListener('resize', scheduleMeasure);
          measure();
        } catch (e) {}
      })();
    </script>

    <script is:inline>
      // Прямая ссылка на вопрос: если хэш указывает на вопрос-ответ (сам <details> из .qa
      // или любой элемент внутри него) — раскрываем этот ответ. Без JS ссылка просто
      // перематывает к свёрнутому вопросу: страница работает как раньше.
      (function () {
        try {
          // Ближайший <details> из блока «вопросы-ответы», содержащий этот элемент.
          function question(target) {
            var el = target;
            while (el && el !== document.body) {
              if (el.tagName === 'DETAILS' && el.parentNode && el.parentNode.classList &&
                  el.parentNode.classList.contains('qa')) {
                return el;
              }
              el = el.parentElement;
            }
            return null;
          }

          function reveal() {
            var hash = location.hash;
            if (!hash || hash.length < 2) return;
            var id = hash.slice(1);
            try {
              id = decodeURIComponent(id);
            } catch (e) {}
            var target = document.getElementById(id);
            var box = target ? question(target) : null;
            if (!box || box.open) return;
            box.open = true;
            // Ответ раскрылся — возвращаемся к вопросу: у .qa details есть
            // scroll-margin-top, поэтому вопрос встаёт под липкой шапкой, а не под ней.
            window.requestAnimationFrame(function () {
              try {
                box.scrollIntoView({ block: 'start' });
              } catch (e) {
                try {
                  box.scrollIntoView();
                } catch (e2) {}
              }
            });
          }

          window.addEventListener('hashchange', reveal);
          reveal();
        } catch (e) {}
      })();
    </script>

    <script is:inline define:vars={{ toDark: t.theme.toDark, toLight: t.theme.toLight }}>
      // Переключатели: тема и язык (запоминаем выбор в localStorage).
      (function () {
        var root = document.documentElement;

        function currentTheme() {
          if (root.dataset.theme) return root.dataset.theme;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function paintTheme() {
          var theme = currentTheme();
          document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
            // Текстовая кнопка: показывает, куда переключим (как сноска в книге).
            btn.textContent = theme === 'dark' ? toLight : toDark;
          });
        }

        document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var next = currentTheme() === 'dark' ? 'light' : 'dark';
            root.dataset.theme = next;
            try {
              localStorage.setItem('about.theme', next);
            } catch (e) {}
            paintTheme();
          });
        });

        document.querySelectorAll('[data-lang]').forEach(function (link) {
          link.addEventListener('click', function () {
            try {
              localStorage.setItem('about.lang', link.dataset.lang);
            } catch (e) {}
          });
        });

        paintTheme();

        // Увеличиваем картинки по клику: оверлей на весь экран, закрытие — клик или Esc
        const images = document.querySelectorAll('article img');
        if (!images.length) return;

        function close(box) {
          box.remove();
          document.body.style.overflow = '';
        }

        function open(src, alt) {
          const box = document.createElement('div');
          box.className = 'lightbox';
          const big = document.createElement('img');
          big.src = src;
          big.alt = alt || '';
          box.appendChild(big);
          box.addEventListener('click', () => close(box));
          document.addEventListener('keydown', function onKey(event) {
            if (event.key === 'Escape') {
              close(box);
              document.removeEventListener('keydown', onKey);
            }
          });
          document.body.style.overflow = 'hidden';
          document.body.appendChild(box);
        }

        images.forEach((img) => {
          img.setAttribute('tabindex', '0');
          img.setAttribute('role', 'button');
          img.setAttribute('title', 'Нажмите, чтобы увеличить');
          img.addEventListener('click', () => open(img.currentSrc || img.src, img.alt));
          img.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              open(img.currentSrc || img.src, img.alt);
            }
          });
        });
      })();
    </script>

    <script is:inline define:vars={{ gate, base }}>
      (function () {
        // Печать: перед печатью раскрываем вопросы-ответы (.qa details), после —
        // возвращаем прежнее состояние. Другие details (если появятся) не трогаем.
        // Событий печати нет — страница читается как есть.
        (function () {
          var restore = null;
          try {
            window.addEventListener('beforeprint', function () {
              try {
                var closed = [];
                document.querySelectorAll('.qa details:not([open])').forEach(function (item) {
                  closed.push(item);
                  item.open = true;
                });
                restore = closed;
              } catch (e) {}
            });

            window.addEventListener('afterprint', function () {
              try {
                if (restore) {
                  restore.forEach(function (item) {
                    item.open = false;
                  });
                }
              } catch (e) {}
              restore = null;
            });
          } catch (e) {}
        })();

        const cfg = { scope: gate.scope, hash: gate.hash, key: gate.key, base: base };
        const path = location.pathname;
        const rel = path.startsWith(cfg.base) ? path.slice(cfg.base.length) : path;
        const isProtected = cfg.scope.some((s) => rel === s || rel.startsWith(s) || rel.startsWith(s + '/'));
        if (!isProtected) return;
        if (localStorage.getItem(cfg.key) === 'ok') return;

        function fnv1a(str) {
          let h = 0x811c9dc5;
          const bytes = new TextEncoder().encode(str);
          for (const b of bytes) {
            h ^= b;
            h = Math.imul(h, 0x01000193) >>> 0;
          }
          return h.toString(16).padStart(8, '0');
        }

        const content = document.getElementById('page-content');
        const box = document.getElementById('gate');
        const form = document.getElementById('gate-form');
        const input = document.getElementById('gate-code');
        const error = document.getElementById('gate-error');
        if (!content || !box || !form || !input || !error) return;

        content.hidden = true;
        box.hidden = false;
        input.focus();

        form.addEventListener('submit', (event) => {
          event.preventDefault();
          if (fnv1a(input.value.trim().toLowerCase()) === cfg.hash) {
            localStorage.setItem(cfg.key, 'ok');
            location.reload();
            return;
          }
          error.hidden = false;
          input.select();
        });
      })();
    </script>

    {!isT1 && (
      <script is:inline>
        // Живой фон: тихий граф за текстом — узлы дрейфуют, «дышат» по глубине,
        // по рёбрам бегут импульсы и передаются дальше по сети; вокруг курсора граф
        // плавно размывается. Без prefers-reduced-motion — статичный одиночный кадр.
        (function () {
          var canvas = document.querySelector('.bg-graph');
          if (!canvas || !canvas.getContext) return;

          var ctx = canvas.getContext('2d');
          var reduced = false;
          try {
            reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          } catch (e) {}

          var DPR = 1, W = 0, H = 0, nodes = [], pulses = [], frame = 0;
          var LINK = 150;
          var MAX_PULSES = 7;
          var CHAIN = 0.65;

          var mouse = { x: 0, y: 0, active: false };
          var BLUR_RADIUS = 260;

          var BANDS = [
            { min: 0.00, filter: 'none' },
            { min: 0.12, filter: 'blur(0.7px)' },
            { min: 0.26, filter: 'blur(1.3px)' },
            { min: 0.40, filter: 'blur(2.0px)' },
            { min: 0.54, filter: 'blur(2.8px)' },
            { min: 0.68, filter: 'blur(3.7px)' },
            { min: 0.82, filter: 'blur(4.6px)' },
            { min: 0.93, filter: 'blur(5.5px)' }
          ];

          window.addEventListener('mousemove', function (e) {
            mouse.x = e.clientX;
            mouse.y = e.clientY;
            mouse.active = true;
          }, { passive: true });
          document.addEventListener('mouseleave', function () {
            mouse.active = false;
          });

          function segDist(px, py, x1, y1, x2, y2) {
            var dx = x2 - x1, dy = y2 - y1;
            var len2 = dx * dx + dy * dy;
            var t = len2 ? ((px - x1) * dx + (py - y1) * dy) / len2 : 0;
            if (t < 0) t = 0;
            if (t > 1) t = 1;
            var cx = x1 + t * dx, cy = y1 + t * dy;
            dx = px - cx; dy = py - cy;
            return Math.sqrt(dx * dx + dy * dy);
          }

          function proximity(px, py) {
            if (!mouse.active) return 0;
            var dx = mouse.x - px, dy = mouse.y - py;
            var d = Math.sqrt(dx * dx + dy * dy);
            if (d >= BLUR_RADIUS) return 0;
            return 1 - d / BLUR_RADIUS;
          }

          function bandOf(prox) {
            var b = 0;
            for (var i = 1; i < BANDS.length; i++) {
              if (prox >= BANDS[i].min) b = i;
            }
            return b;
          }

          function accent() {
            var v = '';
            try {
              v = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
            } catch (e) {}
            var hex = v.match(/^#([0-9a-f]{6})$/i);
            if (hex) {
              var n = parseInt(hex[1], 16);
              return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
            }
            var rgb = v.match(/\d+/g);
            return rgb ? rgb.slice(0, 3).map(Number) : [125, 46, 53];
          }

          function rgba(c, a) {
            return 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + a + ')';
          }

          function resize() {
            DPR = Math.min(window.devicePixelRatio || 1, 2);
            W = window.innerWidth;
            H = window.innerHeight;
            canvas.width = Math.round(W * DPR);
            canvas.height = Math.round(H * DPR);
            canvas.style.width = W + 'px';
            canvas.style.height = H + 'px';
            ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
            seed();
          }

          function seed() {
            var count = Math.max(26, Math.min(64, Math.round((W * H) / 26000)));
            nodes = [];
            for (var i = 0; i < count; i++) {
              nodes.push({
                x: Math.random() * W,
                y: Math.random() * H,
                vx: (Math.random() - 0.5) * 0.3,
                vy: (Math.random() - 0.5) * 0.3,
                r: 1.2 + Math.random() * 1.3,
                hub: i < 3,
                zphase: Math.random() * 6.2832,
                zspeed: 0.006 + Math.random() * 0.010,
                z: 1
              });
            }
            pulses = [];
            frame = 0;
          }

          function neighborsOf(i, maxDist) {
            var res = [], a = nodes[i];
            for (var j = 0; j < nodes.length; j++) {
              if (j === i) continue;
              var b = nodes[j], dx = a.x - b.x, dy = a.y - b.y;
              if (dx * dx + dy * dy < maxDist * maxDist) res.push(j);
            }
            return res;
          }

          function spawnFrom(from) {
            var ns = neighborsOf(from, LINK * 1.5);
            if (!ns.length) return;
            pulses.push({
              from: from,
              to: ns[Math.floor(Math.random() * ns.length)],
              t: 0,
              speed: 0.014 + Math.random() * 0.012
            });
          }

          function spawnPulse() {
            if (Math.random() < 0.45) {
              spawnFrom(Math.floor(Math.random() * 3));
            } else {
              spawnFrom(Math.floor(Math.random() * nodes.length));
            }
          }

          function step() {
            var i, n;
            for (i = 0; i < nodes.length; i++) {
              n = nodes[i];
              n.x += n.vx;
              n.y += n.vy;
              if (n.x < -20) n.x = W + 20;
              if (n.x > W + 20) n.x = -20;
              if (n.y < -20) n.y = H + 20;
              if (n.y > H + 20) n.y = -20;
              n.z = 1 + 0.42 * Math.sin(frame * n.zspeed + n.zphase);
            }
            if (frame % 45 === 0 && pulses.length < MAX_PULSES) spawnPulse();
            for (i = pulses.length - 1; i >= 0; i--) {
              var p = pulses[i];
              p.t += p.speed;
              if (p.t >= 1) {
                pulses.splice(i, 1);
                if (Math.random() < CHAIN) spawnFrom(p.to);
              }
            }
            frame++;
          }

          function draw() {
            var c = accent();
            var i, j, k, a, b, d, prox, band;

            ctx.clearRect(0, 0, W, H);

            for (band = 0; band < BANDS.length; band++) {
              ctx.filter = BANDS[band].filter;

              for (i = 0; i < nodes.length; i++) {
                a = nodes[i];
                for (j = i + 1; j < nodes.length; j++) {
                  b = nodes[j];
                  d = Math.sqrt((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y));
                  if (d >= LINK) continue;
                  var zavg = (a.z + b.z) / 2;
                  prox = 1 - segDist(mouse.x, mouse.y, a.x, a.y, b.x, b.y) / BLUR_RADIUS;
                  if (prox < 0) prox = 0;
                  if (bandOf(prox) !== band) continue;

                  var litA = null, litB = null;
                  for (k = 0; k < pulses.length; k++) {
                    var pl = pulses[k];
                    if (pl.from === i && pl.to === j) litA = pl.t;
                    if (pl.from === j && pl.to === i) litB = pl.t;
                  }

                  ctx.lineWidth = 0.6 + 0.5 * zavg;
                  ctx.strokeStyle = rgba(c, (0.10 * (1 - d / LINK) * (0.55 + 0.45 * zavg)).toFixed(3));
                  ctx.beginPath();
                  ctx.moveTo(a.x, a.y);
                  ctx.lineTo(b.x, b.y);
                  ctx.stroke();

                  if (litA !== null || litB !== null) {
                    var fx = litA !== null ? a.x : b.x;
                    var fy = litA !== null ? a.y : b.y;
                    var tx = litA !== null ? b.x : a.x;
                    var ty = litA !== null ? b.y : a.y;
                    var t = litA !== null ? litA : litB;
                    var px = fx + (tx - fx) * t;
                    var py = fy + (ty - fy) * t;
                    ctx.lineWidth = 3.4 * zavg;
                    ctx.strokeStyle = rgba(c, (0.023 * zavg).toFixed(3));
                    ctx.beginPath();
                    ctx.moveTo(fx, fy);
                    ctx.lineTo(px, py);
                    ctx.stroke();
                    ctx.lineWidth = 1.1;
                    ctx.strokeStyle = rgba(c, (0.084 * zavg).toFixed(3));
                    ctx.beginPath();
                    ctx.moveTo(fx, fy);
                    ctx.lineTo(px, py);
                    ctx.stroke();
                  }
                }
              }

              for (i = 0; i < nodes.length; i++) {
                a = nodes[i];
                if (bandOf(proximity(a.x, a.y)) !== band) continue;
                ctx.fillStyle = rgba(c, (a.hub ? 0.5 : 0.3) * Math.min(1.15, Math.max(0.45, a.z)));
                ctx.beginPath();
                ctx.arc(a.x, a.y, Math.max(0.5, a.r * a.z) + (a.hub ? 1.2 : 0), 0, 6.2832);
                ctx.fill();
              }

              for (i = pulses.length - 1; i >= 0; i--) {
                var p = pulses[i];
                a = nodes[p.from];
                b = nodes[p.to];
                var z = Math.min(1.2, Math.max(0.6, (a.z + b.z) / 2));
                for (var tail = 3; tail >= 0; tail--) {
                  var tt = p.t - tail * 0.022;
                  if (tt <= 0) continue;
                  var xx = a.x + (b.x - a.x) * tt;
                  var yy = a.y + (b.y - a.y) * tt;
                  if (bandOf(proximity(xx, yy)) !== band) continue;
                  if (tail === 0) {
                    ctx.fillStyle = rgba(c, (0.03 * z).toFixed(3));
                    ctx.beginPath();
                    ctx.arc(xx, yy, 5.5 * z, 0, 6.2832);
                    ctx.fill();
                    ctx.fillStyle = rgba(c, Math.min(1, (0.18 * z).toFixed(3)));
                    ctx.beginPath();
                    ctx.arc(xx, yy, Math.max(1, 2.6 * z), 0, 6.2832);
                    ctx.fill();
                  } else {
                    ctx.fillStyle = rgba(c, (0.08 * z / tail).toFixed(3));
                    ctx.beginPath();
                    ctx.arc(xx, yy, Math.max(0.6, (1.8 * z) / tail), 0, 6.2832);
                    ctx.fill();
                  }
                }
              }
            }
            ctx.filter = 'none';
          }

          function loop() {
            if (!document.hidden) {
              step();
              draw();
            }
            window.requestAnimationFrame(loop);
          }

          var resizeTimer = null;
          window.addEventListener('resize', function () {
            if (resizeTimer) window.clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(resize, 150);
          });

          resize();

          if (reduced) {
            for (var k = 0; k < 240; k++) step();
            draw();
          } else {
            loop();
          }
        })();
      </script>
    )}
  </body>
</html>
