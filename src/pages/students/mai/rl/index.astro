---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CourseNav from '../../../../components/CourseNav.astro';
import { withBase } from '../../../../data/site';

const topics = (await getCollection('topics')).sort((a, b) => a.data.number - b.data.number);
const current = Astro.url.pathname;
---

<BaseLayout title="Обучение с подкреплением" description="Материалы курса «Обучение с подкреплением»: темы, лекции и семинары.">
  <div class="course">
    <CourseNav current={current} />

    <div>
      <p class="muted">МАИ · магистратура</p>
      <h1>Обучение с подкреплением</h1>
      <p class="lead">
        Материалы по темам курса: что прошли на лекции и что разбирали на семинаре. Темы
        добавляются по мере прохождения.
      </p>

      <h2 id="topics">Темы</h2>
      <ul class="topic-list">
        {topics.map((topic) => (
          <li>
            <a href={withBase(`students/mai/rl/topics/${topic.id}/`)}>
              <span class="step">Тема {topic.data.number}{topic.data.date ? ` · ${topic.data.date}` : ''}</span>
              <h3>{topic.data.title}</h3>
              <p class="muted">{topic.data.summary}</p>
            </a>
          </li>
        ))}
      </ul>

      <h2 id="homework">Домашние задания</h2>
      <p class="muted">
        Задания вынесены отдельно: <a href={withBase('students/mai/rl/homework/')}>домашние задания →</a>
      </p>
    </div>
  </div>
</BaseLayout>
