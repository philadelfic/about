---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CourseNav from '../../../../../components/CourseNav.astro';
import { withBase } from '../../../../../data/site';
import { homeworkKind, homeworkOrder } from '../../../../../lib/homework.mjs';

const items = (await getCollection('homework'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => homeworkOrder(a) - homeworkOrder(b));
const current = Astro.url.pathname;
---

<BaseLayout title="Домашние задания" description="Домашние задания курса «Обучение с подкреплением».">
  <div class="course">
    <CourseNav current={current} />

    <div>
      <p class="muted">Т1 + МАИ · Обучение с подкреплением</p>
      <h1>Домашние задания</h1>
      <p class="lead">Задания для тренировки: чтобы потренироваться. По ним не ставится зачёт — обязательные работы курса в разделе «Лабораторные».</p>

      {items.length === 0 ? (
        <p class="muted">Пока заданий нет.</p>
      ) : (
        <ul class="topic-list">
          {items.map((item) => (
            <li>
              <a href={withBase(`students/mai/rl/homework/${item.id}/`)}>
                <span class="step">
                  {homeworkKind(item)}
                  {item.data.due ? ` · к ${item.data.due}` : ''}
                </span>
                <h3>{item.data.title}</h3>
                <p class="muted">{item.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>
