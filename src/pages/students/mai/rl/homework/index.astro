---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CourseNav from '../../../../../components/CourseNav.astro';

const items = (await getCollection('homework')).sort(
  (a, b) => (a.data.topic ?? 0) - (b.data.topic ?? 0)
);
const current = Astro.url.pathname;
const rendered = await Promise.all(
  items.map(async (item) => ({ item, Content: (await render(item)).Content }))
);
---

<BaseLayout title="Домашние задания" description="Домашние задания курса «Обучение с подкреплением».">
  <div class="course">
    <CourseNav current={current} />

    <div>
      <p class="muted">МАИ · Обучение с подкреплением</p>
      <h1>Домашние задания</h1>
      <p class="lead">Задания курса: что нужно сделать и к какому сроку.</p>

      {rendered.length === 0 ? (
        <p class="muted">Пока заданий нет — появятся после занятий.</p>
      ) : (
        rendered.map(({ item, Content }) => (
          <article class="panel">
            <h3>{item.data.title}</h3>
            {item.data.due && <p class="muted">Сдать: {item.data.due}</p>}
            <Content />
          </article>
        ))
      )}
    </div>
  </div>
</BaseLayout>
