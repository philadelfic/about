---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CourseNav from '../../../../../components/CourseNav.astro';
import { withBase } from '../../../../../data/site';
import { optionalCollection } from '../../../../../lib/collections';

const items = (await optionalCollection('seminars'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => a.data.number - b.data.number);
const current = Astro.url.pathname;
---

<BaseLayout title="Семинарские занятия" description="Материалы семинарских занятий курса «Обучение с подкреплением».">
  <div class="course">
    <CourseNav current={current} />

    <div>
      <p class="muted">Т1 + МАИ · Обучение с подкреплением</p>
      <h1>Семинарские занятия</h1>
      <p class="lead">Что разбирали на семинарах и материалы к ним.</p>

      {items.length === 0 ? (
        <p class="muted">Занятий пока не было — материалы появятся после первого семинара.</p>
      ) : (
        <ul class="topic-list">
          {items.map((item) => (
            <li>
              <a href={withBase(`students/mai/rl/seminars/${item.id}/`)}>
                <span class="step">
                  Занятие {item.data.number}
                  {item.data.date ? ` · ${item.data.date}` : ''}
                </span>
                <h3>{item.data.title}</h3>
                <p class="muted">{item.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>
