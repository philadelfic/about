---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import SeminarPage from '../../../../../components/SeminarPage.astro';
import { seminarLang, enSeminarId } from '../../../../../lib/seminars.mjs';

// Русские занятия. Английские лежат в /en/students/mai/rl/seminars/ — там же
// переключатель языка, который ведёт сюда (или обратно), если перевод есть.
export async function getStaticPaths() {
  const all = await getCollection('seminars');
  const published = all.filter((item) => !item.data.draft);
  const enIds = new Set(published.map((item) => item.id));
  return published
    .filter((item) => seminarLang(item.id) === 'ru')
    .map((item) => ({
      params: { id: item.id },
      props: {
        item,
        altHref: enIds.has(enSeminarId(item.id))
          ? `en/students/mai/rl/seminars/${item.id}/`
          : null,
      },
    }));
}

const { item, altHref } = Astro.props;
---

<BaseLayout
  title={`Занятие ${item.data.number}. ${item.data.title}`}
  description={item.data.summary}
  altHref={altHref}
>
  <SeminarPage item={item} lang="ru" current={Astro.url.pathname} />
</BaseLayout>
