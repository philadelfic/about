---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CourseNav from '../../../../../components/CourseNav.astro';
import { withBase } from '../../../../../data/site';
import { guideKind, guideOrder } from '../../../../../lib/guides.mjs';

const items = (await getCollection('guides'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => guideOrder(a) - guideOrder(b));
const current = Astro.url.pathname;
---

<BaseLayout title="Руководства" description="Руководства курса «Обучение с подкреплением»: пошаговые инструкции к лабораторным работам.">
  <div class="course">
    <CourseNav current={current} />

    <div>
      <p class="muted">Т1 + МАИ · Обучение с подкреплением</p>
      <h1>Руководства</h1>
      <p class="lead">Пошаговые инструкции к лабораторным работам: что вписать в код, как посчитать таблицу и оформить отчёт.</p>

      {items.length === 0 ? (
        <p class="muted">Пока руководств нет.</p>
      ) : (
        <ul class="topic-list">
          {items.map((item) => (
            <li>
              <a href={withBase(`students/mai/rl/guides/${item.id}/`)}>
                <span class="step">
                  {guideKind(item)}
                </span>
                <h3>{item.data.title}</h3>
                <p class="muted">{item.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>
