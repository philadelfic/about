---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import ResultsPage from '../../../../../components/course/ResultsPage.astro';
import { contentLang, enContentId } from '../../../../../lib/course-lang.mjs';

export async function getStaticPaths() {
  const all = (await getCollection('results')).filter((item) => !item.data.draft);
  const ids = new Set(all.map((item) => item.id));
  return all
    .filter((item) => contentLang(item.id) === 'ru')
    .map((item) => ({
      params: { id: item.id },
      props: {
        item,
        altHref: ids.has(enContentId(item.id)) ? `en/students/mai/rl/results/${item.id}/` : null,
      },
    }));
}

const { item, altHref } = Astro.props;
---

<BaseLayout
  title={`Семинар ${item.data.number}. ${item.data.title} — результаты проверки`}
  description={item.data.summary}
  altHref={altHref}
>
  <ResultsPage item={item} lang="ru" current={Astro.url.pathname} />
</BaseLayout>
