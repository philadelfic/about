---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CourseNav from '../../../../../components/CourseNav.astro';
import { withBase } from '../../../../../data/site';
import { optionalCollection } from '../../../../../lib/collections';

const items = (await optionalCollection('results'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => a.data.number - b.data.number);
const current = Astro.url.pathname;

const passedCount = (item: (typeof items)[number]) =>
  item.data.groups.reduce(
    (sum, group) => sum + group.rows.filter((row) => row.status === 'зачёт').length,
    0
  );
const totalCount = (item: (typeof items)[number]) =>
  item.data.groups.reduce((sum, group) => sum + group.rows.length, 0);
const datesLabel = (item: (typeof items)[number]) =>
  item.data.groups
    .map((group) => group.date)
    .filter(Boolean)
    .join(' · ');
const groupsLabel = (item: (typeof items)[number]) => {
  const names = item.data.groups.map((group) => group.name);
  if (names.length === 0) return '';
  return names.length === 1 ? `Группа ${names[0]}. ` : `Группы: ${names.join(' · ')}. `;
};
---

<BaseLayout
  title="Результаты"
  description="Результаты проверок на семинарских занятиях курса «Обучение с подкреплением»: зачёты, незачёты и что подтянуть."
>
  <div class="course">
    <CourseNav current={current} />

    <div>
      <p class="muted">Т1 + МАИ · Обучение с подкреплением</p>
      <h1>Результаты</h1>
      <p class="lead">Проверки по занятиям: зачёт или незачёт по заданию и что стоит подтянуть.</p>

      {items.length === 0 ? (
        <p class="muted">Результатов пока нет — появятся после проверки заданий первого занятия.</p>
      ) : (
        <ul class="topic-list">
          {items.map((item) => (
            <li>
              <a href={withBase(`students/mai/rl/results/${item.id}/`)}>
                <span class="step">
                  Семинар {item.data.number}
                  {datesLabel(item) ? ` · ${datesLabel(item)}` : ''}
                </span>
                <h3>{item.data.title}</h3>
                <p class="muted">
                  {groupsLabel(item)}Зачёт: {passedCount(item)} из {totalCount(item)}.
                  {item.data.groups.length > 1 ? ' Группа — на странице переключателем.' : ''}
                </p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>
