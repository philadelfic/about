---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CourseNav from '../../../../../components/CourseNav.astro';
import { withBase } from '../../../../../data/site';
import { labKind, labOrder } from '../../../../../lib/labs.mjs';

const items = (await getCollection('labs'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => labOrder(a) - labOrder(b));
const current = Astro.url.pathname;
---

<BaseLayout title="Лабораторные работы" description="Лабораторные работы курса «Обучение с подкреплением»: условие, сроки, файлы и пошаговое руководство.">
  <div class="course">
    <CourseNav current={current} />

    <div>
      <p class="muted">Т1 + МАИ · Обучение с подкреплением</p>
      <h1>Лабораторные работы</h1>
      <p class="lead">Работы курса: условие, сроки сдачи, файлы и пошаговое руководство по каждой.</p>

      {items.length === 0 ? (
        <p class="muted">Пока лабораторных нет.</p>
      ) : (
        <ul class="topic-list">
          {items.map((item) => (
            <li>
              <a href={withBase(`students/mai/rl/labs/${item.id}/`)}>
                <span class="step">
                  {labKind(item)}
                  {item.data.due ? ` · сдать ${item.data.due}` : ''}
                </span>
                <h3>{item.data.title}</h3>
                <p class="muted">{item.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>
