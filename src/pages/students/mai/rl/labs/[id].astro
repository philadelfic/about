---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import LabPage from '../../../../../components/course/LabPage.astro';
import { contentLang, enContentId } from '../../../../../lib/course-lang.mjs';

export async function getStaticPaths() {
  const all = (await getCollection('labs')).filter((item) => !item.data.draft);
  const ids = new Set(all.map((item) => item.id));
  return all
    .filter((item) => contentLang(item.id) === 'ru')
    .map((item) => ({
      params: { id: item.id },
      props: {
        item,
        altHref: ids.has(enContentId(item.id)) ? `en/students/mai/rl/labs/${item.id}/` : null,
      },
    }));
}

const { item, altHref } = Astro.props;
---

<BaseLayout title={item.data.title} description={item.data.summary} altHref={altHref}>
  <LabPage item={item} lang="ru" current={Astro.url.pathname} />
</BaseLayout>
