---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CourseNav from '../../../../../components/CourseNav.astro';
import { withBase } from '../../../../../data/site';

export async function getStaticPaths() {
  const lectures = await getCollection('lectures');
  return lectures.map((lecture) => ({ params: { id: lecture.id }, props: { lecture } }));
}

const { lecture } = Astro.props;
const all = (await getCollection('lectures')).sort((a, b) => a.data.number - b.data.number);
const index = all.findIndex((item) => item.id === lecture.id);
const prev = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;
const current = Astro.url.pathname;
---

<BaseLayout title={`Лекция ${lecture.data.number}. ${lecture.data.title}`} description={lecture.data.summary}>
  <div class="course">
    <CourseNav current={current} />

    <article>
      <p class="muted">Лекция {lecture.data.number}{lecture.data.date ? ` · ${lecture.data.date}` : ''}</p>
      <h1>{lecture.data.title}</h1>
      <p class="lead">{lecture.data.summary}</p>

      <h2>Материалы</h2>
      {lecture.data.slides ? (
        <ul class="links">
          <li><a href={lecture.data.slides}>Слайды лекции (PDF)</a></li>
        </ul>
      ) : (
        <p class="muted">Появятся после лекции.</p>
      )}

      <div class="row" style="margin-top:28px">
        {prev && <a href={withBase(`students/mai/rl/lectures/${prev.id}/`)}>← Лекция {prev.data.number}</a>}
        {next && <a href={withBase(`students/mai/rl/lectures/${next.id}/`)}>Лекция {next.data.number} →</a>}
      </div>
    </article>
  </div>
</BaseLayout>
