---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CourseNav from '../../../../../components/CourseNav.astro';
import { withBase } from '../../../../../data/site';

const topics = (await getCollection('topics')).sort((a, b) => a.data.number - b.data.number);
const current = Astro.url.pathname;

// Тема может закрывать несколько лекций — показываем это в списке.
const lectureLabel = (topic: (typeof topics)[number]) => {
  const items = topic.data.lectures;
  if (items.length === 0) return topic.data.date ? ` · ${topic.data.date}` : '';
  const numbers = items.map((item) => item.number).join(' и ');
  const dates = items.every((item) => item.date) ? ` · ${items.map((item) => item.date).join(', ')}` : '';
  return ` · ${items.length > 1 ? 'лекции' : 'лекция'} ${numbers}${dates}`;
};
---

<BaseLayout title="Темы" description="Пройденные темы курса «Обучение с подкреплением».">
  <div class="course">
    <CourseNav current={current} />

    <div>
      <p class="muted">Т1 + МАИ · Обучение с подкреплением</p>
      <h1>Темы</h1>
      <p class="lead">Пройденные темы: что разбирали, теория и вопросы-ответы.</p>

      {topics.length === 0 ? (
        <p class="muted">Пока тем нет.</p>
      ) : (
        <ul class="topic-list">
          {topics.map((topic) => (
            <li>
              <a href={withBase(`students/mai/rl/topics/${topic.id}/`)}>
                <span class="step">
                  Тема {topic.data.number}{lectureLabel(topic)}
                </span>
                <h3>{topic.data.title}</h3>
                <p class="muted">{topic.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>
