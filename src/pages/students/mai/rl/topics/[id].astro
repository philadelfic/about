---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import TopicPage from '../../../../../components/course/TopicPage.astro';
import { contentLang, enContentId } from '../../../../../lib/course-lang.mjs';

// Русские темы. Английские — в /en/students/mai/rl/topics/.
export async function getStaticPaths() {
  const all = await getCollection('topics');
  const ids = new Set(all.map((item) => item.id));
  return all
    .filter((item) => contentLang(item.id) === 'ru')
    .map((topic) => ({
      params: { id: topic.id },
      props: {
        topic,
        altHref: ids.has(enContentId(topic.id)) ? `en/students/mai/rl/topics/${topic.id}/` : null,
      },
    }));
}

const { topic, altHref } = Astro.props;
---

<BaseLayout
  title={`Тема ${topic.data.number}. ${topic.data.title}`}
  description={topic.data.summary}
  altHref={altHref}
>
  <TopicPage topic={topic} lang="ru" current={Astro.url.pathname} />
</BaseLayout>
