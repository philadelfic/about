---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CourseNav from '../../../../../components/CourseNav.astro';
import { withBase } from '../../../../../data/site';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((topic) => ({ params: { id: topic.id }, props: { topic } }));
}

const { topic } = Astro.props;
const { Content } = await render(topic);
const all = (await getCollection('topics')).sort((a, b) => a.data.number - b.data.number);
const index = all.findIndex((item) => item.id === topic.id);
const prev = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;
const current = Astro.url.pathname;

const href = (value: string) => (value.startsWith('http') ? value : withBase(value));
const isFile = (value: string) => !value.startsWith('http');
---

<BaseLayout
  title={`Тема ${topic.data.number}. ${topic.data.title}`}
  description={topic.data.summary}
>
  <div class="course">
    <CourseNav current={current} />

    <article>
      <p class="muted">
        Тема {topic.data.number}{topic.data.date ? ` · лекция ${topic.data.date}` : ''}
      </p>
      <h1>{topic.data.title}</h1>
      <p class="lead">{topic.data.summary}</p>

      {topic.data.lecture.length > 0 && (
        <ul class="links materials">
          {topic.data.lecture.map((item) => (
            <li>
              {item.href ? (
                <a href={href(item.href)} target={isFile(item.href) ? '_blank' : undefined}>
                  {item.title}
                </a>
              ) : (
                <span>{item.title}</span>
              )}
            </li>
          ))}
        </ul>
      )}

      {topic.data.covered.length > 0 && (
        <div class="panel">
          <b>Что разбирали на лекции</b>
          <ul class="tasks">
            {topic.data.covered.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </div>
      )}

      <h2>Теория</h2>
      <Content />

      {topic.data.qa.length > 0 && (
        <>
          <h2>Вопросы и ответы</h2>
          <div class="qa">
            {topic.data.qa.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </>
      )}

      {topic.data.terms.length > 0 && (
        <>
          <h2>Терминология</h2>
          <table class="terms-table">
            <thead>
              <tr>
                <th>Термин</th>
                <th>Что это</th>
              </tr>
            </thead>
            <tbody>
              {topic.data.terms.map((item) => (
                <tr>
                  <td>{item.term}</td>
                  <td>{item.definition}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )}

      <div class="row" style="margin-top:28px">
        {prev && <a href={withBase(`students/mai/rl/topics/${prev.id}/`)}>← Тема {prev.data.number}</a>}
        {next && <a href={withBase(`students/mai/rl/topics/${next.id}/`)}>Тема {next.data.number} →</a>}
      </div>
    </article>
  </div>
</BaseLayout>
