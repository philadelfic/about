---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../../data/site';

const lectures = await getCollection('lectures');
const labs = await getCollection('labs');
---

<BaseLayout title="МАИ">
  <div class="hero">
    <h1>МАИ</h1>
    <p class="lead">Курсы, которые я веду в магистратуре.</p>
  </div>

  <div class="cards">
    <a class="card" href={withBase('students/mai/rl/')}>
      <h3>Обучение с подкреплением</h3>
      <p>{lectures.length} лекции, {labs.length} лабораторные работы, рубежные контроли.</p>
      <span class="more">Открыть курс →</span>
    </a>
  </div>

  <p class="muted">Материалы по темам добавляются по ходу семестра.</p>
</BaseLayout>
