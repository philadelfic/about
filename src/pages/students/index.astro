---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../data/site';

const sections = [
  {
    href: withBase('students/rl/'),
    title: 'Программа курса',
    text: 'Шесть лекций, три лабораторные, рубежные контроли и экзамен — с датами и материалами по темам.',
  },
  {
    href: withBase('students/rl/#lectures'),
    title: 'Лекции по темам',
    text: 'Каждая тема отдельной страницей: о чём лекция, ключевые понятия, слайды и задачи для самопроверки.',
  },
  {
    href: withBase('students/rl/#labs'),
    title: 'Лабораторные работы',
    text: 'Три работы по четыре занятия: постановка, каркас кода, самостоятельная реализация и защита.',
  },
];
---

<BaseLayout title="Студентам">
  <div class="hero">
    <h1>Студентам</h1>
    <p class="lead">
      Материалы курса «Обучение с подкреплением»: темы лекций, лабораторные, рубежные контроли и
      дополнительные задачи. Курс читается в магистратуре, 3 семестр.
    </p>
  </div>

  <div class="cards">
    {sections.map((section) => (
      <a class="card" href={section.href}>
        <h3>{section.title}</h3>
        <p>{section.text}</p>
        <span class="more">Перейти →</span>
      </a>
    ))}
  </div>

  <h2>Как устроен курс</h2>
  <table>
    <tbody>
      <tr><th>Объём</th><td>4 ЗЕ / 144 ч: лекции 12 ч, лабораторные 24 ч, самостоятельная работа 72 ч</td></tr>
      <tr><th>Лекции</th><td>6 тем по 90 минут</td></tr>
      <tr><th>Практики</th><td>12 занятий на группу — три блока по 4 занятия под три лабораторные</td></tr>
      <tr><th>Контроль</th><td>3 рубежных контроля и экзамен</td></tr>
      <tr><th>Инструменты</th><td>Python, NumPy, Gymnasium, Jupyter</td></tr>
    </tbody>
  </table>

  <h2>С чего начать</h2>
  <p class="muted">
    Откройте <a href={withBase('students/rl/')}>программу курса</a> — там список лекций с датами и
    переход в материалы каждой темы.
  </p>

  <p class="notice">
    Раздел собирается: сейчас доступны программа курса, темы лекций и описания лабораторных.
    Слайды, техзадания и банк дополнительных задач добавим по ходу семестра.
  </p>
</BaseLayout>
