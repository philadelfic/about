---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../data/site';
---

<BaseLayout title="Студентам">
  <div class="hero">
    <p class="overline">Студентам</p>
    <h1>Материалы курсов</h1>
    <p class="lead">Курсы, которые я веду: темы, лекции, семинары и лабораторные работы.</p>
  </div>

  <p class="rule-label">Курсы</p>
  <ul class="index-list">
    <li>
      <a href={withBase('students/mai/')}>
        <span class="index-num">01</span>
        <span class="index-title">Т1 + МАИ</span>
        <span class="index-arrow" aria-hidden="true">&rarr;</span>
        <span class="index-text">Магистратура: курс «Обучение с подкреплением».</span>
      </a>
    </li>
  </ul>

  <p class="muted">Материалы по темам добавляются по ходу семестра.</p>
</BaseLayout>
