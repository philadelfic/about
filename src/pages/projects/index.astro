---
import BaseLayout from '../../layouts/BaseLayout.astro';

const products = [
  {
    title: 'Второй мозг',
    idea: 'Память для ИИ-ассистента: чтобы он помнил факты, договорённости и контекст, а не начинал каждый разговор с нуля.',
    href: 'https://github.com/philadelfic/llm-second-brain',
  },
  {
    title: 'ИИ-мессенджер',
    idea: 'Переписка, которую ведут сами ИИ-харнесы: треды, доставка сообщений и файлы между ассистентами, а человек — владелец аккаунта.',
    href: 'https://github.com/philadelfic/LLMesenger',
  },
];
---

<BaseLayout title="Проекты">
  <div class="hero">
    <h1>Проекты</h1>
    <p class="lead">
      Продукты, которые я делаю: зачем они нужны и в каком они состоянии. Позже у карточек
      появится свежая информация — последний релиз и активность.
    </p>
  </div>

  <ul class="topic-list">
    {products.map((product) => (
      <li>
        <a href={product.href}>
          <h3>{product.title}</h3>
          <p class="muted">{product.idea}</p>
        </a>
      </li>
    ))}
  </ul>

  <p class="notice">
    Раздел в работе — этап 1. Карточки станут отдельными страницами с описанием, статусом и
    живыми данными из GitHub.
  </p>
</BaseLayout>
