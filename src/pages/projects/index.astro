---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../data/site';
import { projectsList, latestRelease } from '../../lib/projects.mjs';

const items = await projectsList('ru');
const latest = new Map(items.map((p) => [p.slug, null]));
for (const project of items) {
  latest.set(project.slug, await latestRelease(project.slug, 'ru'));
}
---

<BaseLayout title="Проекты">
  <div class="hero">
    <h1>Проекты</h1>
    <p class="lead">
      Продукты, которые я делаю: зачем они нужны, как помогают и в каком они состоянии.
    </p>
  </div>

  {items.map((project) => (
    <article class="project-card">
      <h2>
        <a class="project-title" href={withBase(`projects/${project.slug}/`)}>{project.title}</a>
      </h2>
      <p class="project-idea">{project.idea}</p>

      <dl class="project-details">
        <dt>Зачем</dt>
        <dd>{project.why}</dd>
        <dt>Как помогает</dt>
        <dd>{project.how}</dd>
        <dt>Состояние</dt>
        <dd>
          <span class="badge">{project.status}</span>
          {latest.get(project.slug) ? (
            <span class="muted">
              {' '}· версия {latest.get(project.slug)!.data.version} от{' '}
              {latest.get(project.slug)!.data.date}
            </span>
          ) : (
            <span class="muted"> · версий пока нет, продукт анонсирован</span>
          )}
        </dd>
        <dt>Стек</dt>
        <dd class="muted">{project.stack.join(' · ')}</dd>
      </dl>

      <p class="project-actions">
        <a href={withBase(`projects/${project.slug}/`)}>Версии и улучшения →</a>
        {project.repo && (
          <>
            {' '}
            <a class="muted" href={project.repo} target="_blank" rel="noopener">
              Репозиторий на GitHub →
            </a>
          </>
        )}
      </p>
    </article>
  ))}
</BaseLayout>
