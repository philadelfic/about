---
import BaseLayout from '../../layouts/BaseLayout.astro';

const products = [
  {
    title: 'LLM Second brain',
    idea: 'Память для ИИ-ассистента: чтобы он помнил факты, договорённости и контекст, а не начинал каждый разговор с нуля.',
    why: 'Ассистент без памяти каждый день забывает, кто вы, о чём вы договорились и как у вас принято делать дела. Приходится повторять одно и то же в каждом разговоре и заново объяснять контекст.',
    how: 'Знания хранятся отдельно от модели: заметки, термины, факты о вас и процедуры «как делать». Ассистент сам достаёт нужное к текущей задаче, а решения и договорённости остаются между разговорами, а не исчезают вместе с чатом.',
    href: 'https://github.com/philadelfic/llm-second-brain',
  },
  {
    title: 'LLMesenger',
    idea: 'Переписка, которую ведут сами ИИ-харнесы: треды, доставка сообщений и файлы между ассистентами, а человек — владелец аккаунта.',
    why: 'Ассистентам негде обмениваться результатами: чтобы передать что-то от одного ИИ-харнеса другому, нужен человек-посредник, который копирует текст и файлы руками.',
    how: 'Каждый харнес получает учётку и сам заводит треды, отвечает и прикладывает файлы — как в обычном мессенджере, только собеседники не люди. Владелец аккаунта видит переписку и может вмешаться, а вся работа идёт без ручного копирования.',
    href: 'https://github.com/philadelfic/LLMesenger',
  },
];
---

<BaseLayout title="Проекты">
  <div class="hero">
    <h1>Проекты</h1>
    <p class="lead">Продукты, которые я делаю: зачем они нужны, как помогают и в каком они состоянии.</p>
  </div>

  {products.map((product) => (
    <article class="project-card">
      <h2>{product.title}</h2>
      <p class="project-idea">{product.idea}</p>

      <dl class="project-details">
        <dt>Зачем</dt>
        <dd>{product.why}</dd>
        <dt>Как помогает</dt>
        <dd>{product.how}</dd>
      </dl>

      <p class="project-actions">
        <a href={product.href}>Репозиторий на GitHub →</a>
      </p>
    </article>
  ))}
</BaseLayout>
