---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../data/site';
import { projectsList, latestRelease } from '../../../lib/projects.mjs';

const items = await projectsList('en');
const latest = new Map(items.map((p) => [p.slug, null]));
for (const project of items) {
  latest.set(project.slug, await latestRelease(project.slug, 'en'));
}
---

<BaseLayout title="Projects" lang="en">
  <div class="hero">
    <h1>Projects</h1>
    <p class="lead">
      Products I build: why they exist, how they help and where they stand.
    </p>
  </div>

  {items.map((project) => (
    <article class="project-card">
      <h2>
        <a class="project-title" href={withBase(`en/projects/${project.slug}/`)}>{project.title}</a>
      </h2>
      <p class="project-idea">{project.idea}</p>

      <dl class="project-details">
        <dt>Why</dt>
        <dd>{project.why}</dd>
        <dt>How it helps</dt>
        <dd>{project.how}</dd>
        <dt>Status</dt>
        <dd>
          <span class="badge">{project.status}</span>
          {latest.get(project.slug) ? (
            <span class="muted">
              {' '}· version {latest.get(project.slug)!.data.version} of{' '}
              {latest.get(project.slug)!.data.date}
            </span>
          ) : (
            <span class="muted"> · no releases yet, announced</span>
          )}
        </dd>
        <dt>Stack</dt>
        <dd class="muted">{project.stack.join(' · ')}</dd>
      </dl>

      <p class="project-actions">
        <a href={withBase(`en/projects/${project.slug}/`)}>Versions and improvements →</a>
        {project.repo && (
          <>
            {' '}
            <a class="muted" href={project.repo} target="_blank" rel="noopener">
              Repository on GitHub →
            </a>
          </>
        )}
      </p>
    </article>
  ))}
</BaseLayout>
