---
import { getCollection } from 'astro:content';
import ReleasePage from '../../../../../components/ReleasePage.astro';
import { releasesOf, hasBody } from '../../../../../lib/projects.mjs';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter(
    (entry) => !entry.data.draft && entry.data.kind !== 'announcement'
  );
  const paths = [];
  for (const project of projects) {
    const releases = (await releasesOf(project.data.slug, 'en')).filter(hasBody);
    for (const release of releases) {
      paths.push({
        params: { slug: project.data.slug, version: release.data.version },
        props: { release },
      });
    }
  }
  return paths;
}

const { release } = Astro.props;
---

<ReleasePage lang="en" release={release} />
