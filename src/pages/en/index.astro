---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { externalLinks, withBase } from '../../data/site';

const entries = [
  {
    href: withBase('en/projects/'),
    title: 'Projects',
    text: 'Two products — LLM Second brain and LLMesenger: why they exist and how they help.',
  },
  {
    href: withBase('en/students/'),
    title: 'Students',
    text: 'The Reinforcement Learning course: topics, lectures and seminars.',
  },
];

const links = [
  { title: 'GitHub', href: externalLinks[0].href, note: 'code and releases' },
  {
    title: 'Telegram channel “Hobby of an IT guy”',
    href: externalLinks[1].href,
    note: 'personal blog (in Russian)',
  },
];

const roles = 'IT lead of a development team · teacher at MAI';
---

<BaseLayout>
  <div class="hero">
    <p class="overline">{roles}</p>
    <h1>Oleg Orlovsky</h1>
    <p class="lead">
      I build HR self-service systems with my team. I teach Reinforcement Learning in a master’s
      programme and build tools for LLM harnesses. Here — my projects and study materials, for
      students and for anyone curious about what I do.
    </p>
  </div>

  <p class="rule-label">Sections</p>
  <ul class="index-list">
    {entries.map((entry, index) => (
      <li>
        <a href={entry.href}>
          <span class="index-num">{String(index + 1).padStart(2, '0')}</span>
          <span class="index-title">{entry.title}</span>
          <span class="index-arrow" aria-hidden="true">&rarr;</span>
          <span class="index-text">{entry.text}</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="rule-label">Links</p>
  <ul class="links">
    {links.map((link) => (
      <li>
        <a href={link.href}>{link.title}</a>
        <span class="link-note">— {link.note}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
