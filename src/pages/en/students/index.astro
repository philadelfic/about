---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../data/site';
---

<BaseLayout title="Students">
  <div class="hero">
    <p class="overline">Students</p>
    <h1>Course materials</h1>
    <p class="lead">
      The “Reinforcement Learning” course I teach: from task formulation and the agent–environment
      loop to tabular methods and Q-learning.
    </p>
  </div>

  <p class="rule-label">Courses</p>
  <ul class="index-list">
    <li>
      <a href={withBase('students/mai/')}>
        <span class="index-num">01</span>
        <span class="index-title">Reinforcement Learning (MAI)</span>
        <span class="index-arrow" aria-hidden="true">&rarr;</span>
        <span class="index-text">Syllabus, topics with theory and Q&amp;A, homework and seminar notes.</span>
      </a>
    </li>
  </ul>

  <p class="muted">
    Course materials are in Russian. Access to the course section is open to my students — the
    section asks for the code I give in class.
  </p>
</BaseLayout>
