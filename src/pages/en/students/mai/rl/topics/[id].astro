---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import TopicPage from '../../../../../../components/course/TopicPage.astro';
import { contentLang, contentSlug } from '../../../../../../lib/course-lang.mjs';

export async function getStaticPaths() {
  const all = await getCollection('topics');
  const ruIds = new Set(all.filter((item) => contentLang(item.id) === 'ru').map((item) => item.id));
  return all
    .filter((item) => contentLang(item.id) === 'en')
    .map((topic) => {
      const slug = contentSlug(topic.id);
      return {
        params: { id: slug },
        props: { topic, altHref: ruIds.has(slug) ? `students/mai/rl/topics/${slug}/` : null },
      };
    });
}

const { topic, altHref } = Astro.props;
---

<BaseLayout
  title={`Topic ${topic.data.number}. ${topic.data.title}`}
  description={topic.data.summary}
  lang="en"
  altHref={altHref}
>
  <TopicPage topic={topic} lang="en" current={Astro.url.pathname} />
</BaseLayout>
