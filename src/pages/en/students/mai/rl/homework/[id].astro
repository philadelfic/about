---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import HomeworkPage from '../../../../../../components/course/HomeworkPage.astro';
import { contentLang, contentSlug } from '../../../../../../lib/course-lang.mjs';

export async function getStaticPaths() {
  const all = await getCollection('homework');
  const ruIds = new Set(all.filter((item) => contentLang(item.id) === 'ru').map((item) => item.id));
  return all
    .filter((item) => contentLang(item.id) === 'en')
    .map((item) => {
      const slug = contentSlug(item.id);
      return {
        params: { id: slug },
        props: { item, altHref: ruIds.has(slug) ? `students/mai/rl/homework/${slug}/` : null },
      };
    });
}

const { item, altHref } = Astro.props;
---

<BaseLayout title={item.data.title} description={item.data.summary} lang="en" altHref={altHref}>
  <HomeworkPage item={item} lang="en" current={Astro.url.pathname} />
</BaseLayout>
