---
/**
 * «Results» — точка входа раздела (английская версия). Отдельных страниц проверок
 * больше нет: всё в одной таблице «Работы семестра». Английской таблицы пока нет —
 * кнопка ведёт на русскую, она единственная (lang="ru" у WorksPage).
 */
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import CourseNav from '../../../../../../components/CourseNav.astro';
import { withBase } from '../../../../../../data/site';
import { chrome } from '../../../../../../data/course-i18n';

const t = chrome('en');
---

<BaseLayout
  title="Results"
  description="All checks and points of the Reinforcement Learning course are collected in one table — by students, works and sessions."
  lang="en"
  altHref="students/mai/rl/results/"
>
  <div class="course">
    <CourseNav current={Astro.url.pathname} lang="en" />

    <div>
      <p class="muted">{t.courseTitle}</p>
      <h1>Results</h1>
      <p class="lead">All checks and points are collected in one table — by students, works and sessions</p>
      <a class="entry-cta" href={withBase('students/mai/rl/works/')}>Open the table →</a>
    </div>
  </div>
</BaseLayout>
