---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { externalLinks, links, withBase } from '../../data/site';

const findMe = [
  { title: 'GitHub', href: externalLinks[0].href, note: 'code and releases' },
  {
    title: 'Telegram channel “Hobby of an IT guy”',
    href: externalLinks[1].href,
    note: 'personal blog (in Russian)',
  },
];
---

<BaseLayout title="About me">
  <article>
    <div class="hero">
      <p class="overline">About me</p>
      <h1>An engineer who teaches</h1>
      <p class="lead">
        IT lead of a development team, I teach reinforcement learning and build my own tools for
        working with LLMs.
      </p>
    </div>

    <h2>What I do</h2>
    <p>
      <strong>Work.</strong> IT lead of a development team: I build HR self-service services with my
      team. I work at InnoTech (T1 Holding).
    </p>
    <p>
      <strong>Teaching.</strong> I teach the “Reinforcement Learning” course in a master’s programme
      (MAI). Course materials live in the <a href={withBase('en/students/')}>Students</a> section —
      they are in Russian.
    </p>

    <h2>Outside work</h2>
    <p>
      <strong>My projects.</strong> “LLM Second brain” — memory for AI assistants; “LLMesenger” —
      messaging between AI harnesses. I write in a <a href={links.telegram}>personal blog</a> (in Russian).
    </p>
    <p>
      <strong>Hobbies.</strong> Woodworking, hardware, 3D printing and notes about whatever seems
      interesting.
    </p>

    <p class="rule-label">Where to find me</p>
    <ul class="links">
      {findMe.map((link) => (
        <li>
          <a href={link.href}>{link.title}</a>
          <span class="link-note">— {link.note}</span>
        </li>
      ))}
    </ul>
  </article>
</BaseLayout>
