---
import BaseLayout from '../layouts/BaseLayout.astro';
import { externalLinks, withBase } from '../data/site';

const entries = [
  {
    href: withBase('projects/'),
    title: 'Проекты',
    text: 'Чем занимаюсь сейчас: LLMesenger, LLM Second Brain, блог. Со свежими релизами и активностью.',
  },
  {
    href: withBase('articles/'),
    title: 'Статьи',
    text: 'Заметки и разборы: инструменты, GitHub, инженерия, обучение с подкреплением.',
  },
  {
    href: withBase('students/'),
    title: 'Студентам',
    text: 'Материалы курса «Обучение с подкреплением» (МАИ): темы, слайды, дополнительные задачи.',
  },
];
---

<BaseLayout>
  <h1>Привет, я Олег</h1>
  <p class="lead">
    Руковожу ИТ-командой сервиса самообслуживания работников (СУБО 2020), преподаю «Обучение с
    подкреплением» в МАИ и делаю инструменты для работы с LLM. Здесь собираю то, что может быть
    полезно другим: проекты, статьи и материалы для студентов.
  </p>

  <div class="cards">
    {entries.map((entry) => (
      <a class="card" href={entry.href}>
        <h3>{entry.title}</h3>
        <p>{entry.text}</p>
      </a>
    ))}
  </div>

  <h2>Ссылки</h2>
  <ul class="links">
    {externalLinks.map((link) => (
      <li>
        <a href={link.href}>{link.title}</a>
        <span class="muted"> — {link.note}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
