---
import BaseLayout from '../layouts/BaseLayout.astro';
import { externalLinks, withBase } from '../data/site';

const entries = [
  {
    href: withBase('projects/'),
    title: 'Проекты',
    text: 'Чем занимаюсь сейчас: LLMesenger, LLM Second Brain и блог. Со свежими релизами и активностью.',
  },
  {
    href: withBase('articles/'),
    title: 'Статьи',
    text: 'Заметки и разборы: инструменты, GitHub, инженерия, обучение с подкреплением.',
  },
  {
    href: withBase('students/'),
    title: 'Студентам',
    text: 'Курс «Обучение с подкреплением»: программа, темы и лабораторные работы.',
  },
];
---

<BaseLayout>
  <div class="hero">
    <h1>Привет, я Олег.<br /><span class="grad">Делаю сервисы и преподаю RL</span></h1>
    <p class="lead">
      Работаю в ИТ: руковожу разработкой корпоративных сервисов для сотрудников. Читаю курс
      «Обучение с подкреплением» в магистратуре и делаю инструменты для работы с LLM. Здесь
      собираю то, что может быть полезно другим.
    </p>
  </div>

  <div class="cards">
    {entries.map((entry) => (
      <a class="card" href={entry.href}>
        <h3>{entry.title}</h3>
        <p>{entry.text}</p>
        <span class="more">Открыть →</span>
      </a>
    ))}
  </div>

  <h2>Ссылки</h2>
  <ul class="links">
    {externalLinks.map((link) => (
      <li>
        <a href={link.href}>{link.title}</a>
        <span class="muted"> — {link.note}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
