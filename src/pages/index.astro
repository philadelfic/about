---
import BaseLayout from '../layouts/BaseLayout.astro';
import { externalLinks, withBase } from '../data/site';

const entries = [
  {
    href: withBase('projects/'),
    title: 'Проекты',
    text: 'Два продукта — LLM Second brain и LLMesenger: зачем они нужны и как помогают.',
  },
  {
    href: withBase('students/'),
    title: 'Студентам',
    text: 'Материалы курса «Обучение с подкреплением»: темы, лекции и семинары.',
  },
];

const roles = 'ИТ-лид команды разработки · преподаватель МАИ';
---

<BaseLayout>
  <div class="hero">
    <p class="overline">{roles}</p>
    <h1>Олег Орловский</h1>
    <p class="lead">
      Разрабатываю с командой кадровые сервисы самообслуживания. Преподаю «Обучение с подкреплением»
      в магистратуре и делаю инструменты для работы с LLM-харнесами. Здесь — проекты и материалы
      для студентов и тех, кому интересны мои проекты.
    </p>
  </div>

  <p class="rule-label">Разделы</p>
  <ul class="index-list">
    {entries.map((entry, index) => (
      <li>
        <a href={entry.href}>
          <span class="index-num">{String(index + 1).padStart(2, '0')}</span>
          <span class="index-title">{entry.title}</span>
          <span class="index-arrow" aria-hidden="true">&rarr;</span>
          <span class="index-text">{entry.text}</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="rule-label">Ссылки</p>
  <ul class="links">
    {externalLinks.map((link) => (
      <li>
        <a href={link.href}>{link.title}</a>
        <span class="link-note">— {link.note}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
