---
import { getCollection } from 'astro:content';
import { withBase } from '../data/site';
import { homeworkLabel, homeworkOrder } from '../lib/homework.mjs';
import { labKind, labOrder } from '../lib/labs.mjs';

interface Props {
  current: string;
}

const { current } = Astro.props;

const topics = (await getCollection('topics')).sort((a, b) => a.data.number - b.data.number);
const homework = (await getCollection('homework'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => homeworkOrder(a) - homeworkOrder(b));
const seminars = (await getCollection('seminars'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => a.data.number - b.data.number);
const results = (await getCollection('results'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => a.data.number - b.data.number);
const labs = (await getCollection('labs'))
  .filter((item) => !item.data.draft && item.data.issued)
  .sort((a, b) => labOrder(a) - labOrder(b));

const sections = {
  topics: withBase('students/mai/rl/topics/'),
  homework: withBase('students/mai/rl/homework/'),
  labs: withBase('students/mai/rl/labs/'),
  seminars: withBase('students/mai/rl/seminars/'),
  results: withBase('students/mai/rl/results/'),
};

// Какая часть курса открыта сейчас — от этого зависит нижний список.
const section = current.startsWith(sections.homework)
  ? 'homework'
  : current.startsWith(sections.labs)
    ? 'labs'
    : current.startsWith(sections.seminars)
    ? 'seminars'
    : current.startsWith(sections.results)
      ? 'results'
      : 'topics';

const isCurrent = (href: string) => current === href;

// У проверки может быть несколько групп — в подсписке показываем их даты через запятую.
const resultsLabel = (item: (typeof results)[number]) => {
  const dates = item.data.groups
    .map((group) => group.date)
    .filter(Boolean)
    .join(', ');
  return `Семинар ${item.data.number}${dates ? ` · ${dates}` : ''}`;
};
---

<nav class="course-nav">
  <h2>
    <a href={withBase('students/mai/rl/')}>Курс</a>
  </h2>
  <ul>
    <li>
      <a href={sections.topics} aria-current={section === 'topics' ? 'page' : undefined}> Темы </a>
    </li>
    <li>
      <a href={sections.homework} aria-current={section === 'homework' ? 'page' : undefined}>
        Домашние задания
      </a>
    </li>
    <li>
      <a href={sections.labs} aria-current={section === 'labs' ? 'page' : undefined}>
        Лабораторные
      </a>
    </li>
    <li>
      <a href={sections.seminars} aria-current={section === 'seminars' ? 'page' : undefined}>
        Семинарские занятия
      </a>
    </li>
    <li>
      <a href={sections.results} aria-current={section === 'results' ? 'page' : undefined}>
        Результаты
      </a>
    </li>
  </ul>

  {section === 'results' && results.length > 0 && (
    <>
      <h2>
        <a href={sections.results}>Проверки</a>
      </h2>
      <ul>
        {results.map((item) => {
          const href = withBase(`students/mai/rl/results/${item.id}/`);
          return (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {resultsLabel(item)}
              </a>
            </li>
          );
        })}
      </ul>
    </>
  )}

  {section === 'homework' && homework.length > 0 && (
    <>
      <h2>
        <a href={sections.homework}>Задания</a>
      </h2>
      <ul>
        {homework.map((item) => {
          const href = withBase(`students/mai/rl/homework/${item.id}/`);
          return (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {homeworkLabel(item)}
                {item.data.due && <span class="muted"> · к {item.data.due}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </>
  )}

  {section === 'labs' && labs.length > 0 && (
    <>
      <h2>
        <a href={sections.labs}>Лабораторные</a>
      </h2>
      <ul>
        {labs.map((item) => {
          const href = withBase(`students/mai/rl/labs/${item.id}/`);
          return (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {labKind(item)}
                <span class="muted"> · {item.data.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </>
  )}

  {section === 'seminars' && seminars.length > 0 && (
    <>
      <h2>
        <a href={sections.seminars}>Занятия</a>
      </h2>
      <ul>
        {seminars.map((item) => {
          const href = withBase(`students/mai/rl/seminars/${item.id}/`);
          return (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                Занятие {item.data.number}
                {item.data.date && <span class="muted"> · {item.data.date}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </>
  )}

  {section === 'topics' && (
    <>
      <h2>
        <a href={sections.topics}>Пройденные темы</a>
      </h2>
      <ul>
        {topics.map((topic) => {
          const href = withBase(`students/mai/rl/topics/${topic.id}/`);
          return (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                <span class="num">{topic.data.number}</span>
                {topic.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    </>
  )}
</nav>
