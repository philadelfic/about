---
/**
 * Меню курса в левой колонке. Одно на два языка: адреса и подписи берутся
 * по lang, списки — только записи своего языка (английские лежат в en/).
 *
 * Отдельных страниц проверок больше нет: все проверки и баллы живут в одной
 * таблице «Работы семестра», поэтому пункт «Результаты» ведёт сразу на неё.
 */
import { getCollection } from 'astro:content';
import { withBase } from '../data/site';
import { homeworkLabel, homeworkOrder } from '../lib/homework.mjs';
import { labKind, labOrder } from '../lib/labs.mjs';
import { chrome } from '../data/course-i18n';
import type { Lang } from '../data/i18n';
import { contentLang } from '../lib/course-lang.mjs';

interface Props {
  current: string;
  lang?: Lang;
}

const { current, lang = 'ru' } = Astro.props;
const t = chrome(lang);
const prefix = lang === 'en' ? 'en/students/mai/rl/' : 'students/mai/rl/';
const own = (items: any[]) => items.filter((item) => !item.data.draft && contentLang(item.id) === lang);

const topics = own(await getCollection('topics')).sort((a: any, b: any) => a.data.number - b.data.number);
const homework = own(await getCollection('homework')).sort(
  (a: any, b: any) => homeworkOrder(a) - homeworkOrder(b)
);
const seminars = own(await getCollection('seminars')).sort(
  (a: any, b: any) => a.data.number - b.data.number
);
const labs = own(await getCollection('labs'))
  .filter((item: any) => item.data.issued)
  .sort((a: any, b: any) => labOrder(a) - labOrder(b));

// Таблица работ одна на весь раздел: своего адреса у проверок нет, пункт меню
// ведёт прямо на неё. Английской таблицы пока нет — она одна, русская.
const worksPath = withBase('students/mai/rl/works/');

const sections = {
  topics: withBase(`${prefix}topics/`),
  homework: withBase(`${prefix}homework/`),
  labs: withBase(`${prefix}labs/`),
  seminars: withBase(`${prefix}seminars/`),
  results: worksPath,
};

// Какая часть курса открыта сейчас — от этого зависит нижний список.
// «Результаты» — это и страница-вход раздела (results/), и сама таблица (works/).
const isResults =
  current.startsWith(worksPath) || current.startsWith(withBase(`${prefix}results/`));

const section = current.startsWith(sections.homework)
  ? 'homework'
  : current.startsWith(sections.labs)
    ? 'labs'
    : current.startsWith(sections.seminars)
      ? 'seminars'
      : isResults
        ? 'results'
        : 'topics';

const isCurrent = (href: string) => current === href;
---

<nav class="course-nav">
  <h2>
    <a href={withBase(prefix)}>{t.courseShort}</a>
  </h2>
  <ul>
    <li>
      <a href={sections.topics} aria-current={section === 'topics' ? 'page' : undefined}>
        {t.navTopics}
      </a>
    </li>
    <li>
      <a href={sections.homework} aria-current={section === 'homework' ? 'page' : undefined}>
        {t.navHomework}
      </a>
    </li>
    <li>
      <a href={sections.labs} aria-current={section === 'labs' ? 'page' : undefined}>
        {t.navLabsShort}
      </a>
    </li>
    <li>
      <a href={sections.seminars} aria-current={section === 'seminars' ? 'page' : undefined}>
        {t.navSeminars}
      </a>
    </li>
    <li>
      <a href={sections.results} aria-current={section === 'results' ? 'page' : undefined}>
        {t.navResults}
      </a>
    </li>
  </ul>

  {section === 'homework' && homework.length > 0 && (
    <>
      <h2>
        <a href={sections.homework}>{t.navTasks}</a>
      </h2>
      <ul>
        {homework.map((item: any) => {
          const href = withBase(`${prefix}homework/${item.id.replace(/^en\//, '')}/`);
          return (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {homeworkLabel(item, lang)}
                {item.data.due && <span class="muted"> · {t.navDue} {item.data.due}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </>
  )}

  {section === 'labs' && labs.length > 0 && (
    <>
      <h2>
        <a href={sections.labs}>{t.navLabsShort}</a>
      </h2>
      <ul>
        {labs.map((item: any) => {
          const href = withBase(`${prefix}labs/${item.id.replace(/^en\//, '')}/`);
          return (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {labKind(item, lang)}
                <span class="muted"> · {item.data.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </>
  )}

  {section === 'seminars' && seminars.length > 0 && (
    <>
      <h2>
        <a href={sections.seminars}>{t.navSessions}</a>
      </h2>
      <ul>
        {seminars.map((item: any) => {
          const href = withBase(`${prefix}seminars/${item.id.replace(/^en\//, '')}/`);
          return (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {t.seminarWord} {item.data.number}
                {item.data.date && <span class="muted"> · {item.data.date}</span>}
              </a>
            </li>
          );
        })}
      </ul>
    </>
  )}

  {section === 'topics' && (
    <>
      <h2>
        <a href={sections.topics}>{t.navTopicsDone}</a>
      </h2>
      <ul>
        {topics.map((topic: any) => {
          const href = withBase(`${prefix}topics/${topic.id.replace(/^en\//, '')}/`);
          return (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                <span class="num">{topic.data.number}</span>
                {topic.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    </>
  )}
</nav>
