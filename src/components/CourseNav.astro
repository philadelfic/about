---
import { getCollection } from 'astro:content';
import { withBase } from '../data/site';

interface Props {
  current: string;
}

const { current } = Astro.props;
const topics = (await getCollection('topics')).sort((a, b) => a.data.number - b.data.number);
const isCurrent = (href: string) => current === href;
---

<nav class="course-nav">
  <h2>Курс</h2>
  <ul>
    <li>
      <a
        href={withBase('students/mai/rl/')}
        aria-current={isCurrent(withBase('students/mai/rl/')) ? 'page' : undefined}
      >
        Темы
      </a>
    </li>
    <li>
      <a
        href={withBase('students/mai/rl/homework/')}
        aria-current={isCurrent(withBase('students/mai/rl/homework/')) ? 'page' : undefined}
      >
        Домашние задания
      </a>
    </li>
  </ul>

  <h2>Пройденные темы</h2>
  <ul>
    {topics.map((topic) => {
      const href = withBase(`students/mai/rl/topics/${topic.id}/`);
      return (
        <li>
          <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
            <span class="num">{topic.data.number}</span>
            {topic.data.title}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
