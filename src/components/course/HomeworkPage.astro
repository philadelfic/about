---
/** Страница домашнего задания — одна на два языка. */
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import CourseNav from '../CourseNav.astro';
import { chrome } from '../../data/course-i18n';
import type { Lang } from '../../data/i18n';

interface Props {
  item: CollectionEntry<'homework'>;
  lang: Lang;
  current: string;
}

const { item, lang, current } = Astro.props;
const t = chrome(lang);
const { Content } = await render(item);

const marks = [
  item.data.lecture ? t.homeworkByLecture(item.data.lecture) : '',
  item.data.seminar ? t.homeworkBySeminar(item.data.seminar) : '',
  item.data.topic ? t.homeworkByTopic(item.data.topic) : '',
].join('');
---

<div class="course">
  <CourseNav current={current} lang={lang} />

  <article>
    <p class="muted">{t.homeworkWord}{marks}</p>
    <h1>{item.data.title}</h1>
    <p class="lead">{item.data.due ? `${t.submitBy}: ${item.data.due}` : ''}</p>

    <Content />
  </article>
</div>
